# Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: Comma-separated list of admin user IDs allowed to use admin-only commands
ADMIN_USER_IDS=

# Provider selection: sample (default) or custom
PROVIDER=sample

# Sample provider path to JSON file of deals
SAMPLE_DEALS_JSON=data/sample_deals.json

# Scheduling defaults (minutes)
DEFAULT_SUBSCRIPTION_INTERVAL_MIN=180

# Database path
DATABASE_PATH=data/bot.sqlite3

# Timezone for scheduling
TZ=UTC