# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# AliExpress Affiliate API Credentials
ALIEXPRESS_APP_KEY=YOUR_ALIEXPRESS_APP_KEY
ALIEXPRESS_APP_SECRET=YOUR_ALIEXPRESS_APP_SECRET
ALIEXPRESS_TRACKING_ID=default

# Regional Settings for Product Details API
# Target Currency: USD, GBP, CAD, EUR, UAH, MXN, TRY, RUB, BRL, AUD, INR, JPY, IDR, SEK, KRW
TARGET_CURRENCY=USD

# Target Language: EN, RU, PT, ES, FR, ID, IT, TH, JA, AR, VI, TR, DE, HE, KO, NL, PL, MX, CL, IN
TARGET_LANGUAGE=EN

# Query Country: US, GB, CA, DE, FR, ES, IT, RU, BR, AU, IN, JP, ID, SE, KR, etc.
QUERY_COUNTRY=US